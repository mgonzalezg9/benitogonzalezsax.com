---
import Layout from '../layouts/Layout.astro';
import Header from '../components/parts/Header.astro';
import Hero from '../components/parts/Hero.astro';
import About from '../components/parts/About.astro';
import Services from '../components/parts/Services.astro';
import Gallery from '../components/parts/Gallery.astro';
import Testimonials from '../components/parts/Testimonials.astro';
import Contact from '../components/parts/Contact.astro';
import Footer from '../components/parts/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={t.meta.title} description={t.meta.description} lang={lang}>
  <Header />
  <Hero />
  <About />
  <Services />
  <Gallery />
  <Testimonials />
  <Contact />
  <Footer />
</Layout>