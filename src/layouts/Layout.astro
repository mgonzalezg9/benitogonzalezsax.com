---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Benito González García - Saxofonista profesional para eventos, bodas y celebraciones" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+jpg" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/fonts/styles.css">
    <link rel="preload" href="/fonts/SegmentAKeyTrial-Black.otf" as="font" type="font/otf" crossorigin="anonymous">
    <link rel="preload" href="/fonts/SegmentAKeyTrial-Bold.otf" as="font" type="font/otf" crossorigin="anonymous">
    <link rel="preload" href="/fonts/SegmentAKeyTrial-Regular.otf" as="font" type="font/otf" crossorigin="anonymous">
  </head>
  <body class="bg-gray-50 text-gray-800">
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: 'Inter', sans-serif;
  }
</style>