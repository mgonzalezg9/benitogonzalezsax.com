---
import ScrollSmootherContainer from './parts/ScrollSmootherContainer.astro';
import GoogleAnalytics from './parts/GoogleAnalytics.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Benito González García - Saxofonista profesional para eventos, bodas y celebraciones" } = Astro.props;

const preloadedFonts = [
  "/fonts/SegmentAKeyTrial-Black.otf",
  "/fonts/SegmentAKeyTrial-Bold.otf",
  "/fonts/SegmentAKeyTrial-Regular.otf",
  "/fonts/Inter-Black.otf",
  "/fonts/Inter-Bold.otf",
  "/fonts/Inter-Regular.otf"
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+jpg" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={title} />
    <title>{title}</title>

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <link rel="stylesheet" href="/fonts/styles.css">
    {preloadedFonts.map(font => (
      <link rel="preload" href={font} as="font" type="font/otf" crossorigin="anonymous" />
    ))}

    <GoogleAnalytics />
  </head>
  <body class="bg-gray-50 text-gray-800">
    <ScrollSmootherContainer>
      <slot />
    </ScrollSmootherContainer>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: 'Inter', sans-serif;
  }
</style>