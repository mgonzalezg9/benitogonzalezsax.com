---
import RingIcon from "../assets/icons/ring.svg";
import BriefcaseIcon from "../assets/icons/briefcase.svg";
import PartyIcon from "../assets/icons/party.svg";
import HotelIcon from "../assets/icons/hotel.svg";

const services = [
  {
    title: "Bodas",
    description:
      "Música elegante para tu ceremonia, cóctel, banquete o barra libre. Momentos especiales acompañados de melodías inolvidables.",
    icon: "ring",
  },
  {
    title: "Eventos corporativos",
    description:
      "Amenización musical para conferencias, cenas de empresa o inauguraciones. El toque perfecto para impresionar a tus clientes.",
    icon: "briefcase",
  },
  {
    title: "Fiestas privadas",
    description:
      "Desde cumpleaños hasta aniversarios. Crea una atmósfera única con música en directo que sorprenderá a tus invitados.",
    icon: "party",
  },
  {
    title: "Hoteles y restaurantes",
    description:
      "Música ambiental para tu establecimiento. Mejora la experiencia de tus clientes con un ambiente sofisticado.",
    icon: "hotel",
  },
];
---

<section id="servicios" class="py-12 md:py-16 lg:py-20 bg-gray-50 min-h-screen flex items-center">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2
        class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary"
      >
        Mis servicios
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Ofrezco música en vivo de saxofón con backing tracks que me acompañan. Desde cócteles y música elegante a los estilos más animados. Además, las ofertas de saxofonista y violinista y Sax&DJ completan la oferta para que tu evento cuente con la mejor música de principio a fin.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        services.map((service) => (
          <div class="bg-white rounded-lg shadow-md p-6 transition-transform hover:-translate-y-2">
            <div class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center mb-6 mx-auto">
              {service.icon === "ring" && <RingIcon />}
              {service.icon === "briefcase" && <BriefcaseIcon />}
              {service.icon === "party" && <PartyIcon />}
              {service.icon === "hotel" && <HotelIcon />}
            </div>

            <h3 class="text-xl uppercase font-semibold mb-3 text-center text-black">
              {service.title}
            </h3>
            <p class="text-gray-600 text-center">{service.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 text-center">
      <a
        href="#contacto"
        aria-label="Ir a la sección de contacto para solicitar presupuesto"
        class="font-segmentA uppercase text-4xl tracking-wide inline-block bg-accent hover:bg-amber-400 text-white font-medium pb-2 px-8 rounded-full transition-colors"
      >
        Solicitar presupuesto
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector("#servicios");

    if (!section) {
      console.error(`Section not found`);
      return;
    }

    const title = section.querySelector("h2");
    const description = section.querySelector(".text-lg");
    const cards = section.querySelectorAll(".bg-white");
    const cta = section.querySelector(".mt-16 a");

    const splitTitle = new SplitText(title, { type: "lines" });
    const splitDesc = new SplitText(description, { type: "lines" });

    const timeline = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom top",
        scrub: 1,
        pin: true,
        anticipatePin: 1
      },
      defaults: { ease: "none" }
    });

    timeline
      .from(splitTitle.lines, {
        opacity: 0,
        y: 50,
        stagger: 0.02,
      })
      .from(splitDesc.lines, {
        opacity: 0,
        y: 20,
        stagger: 0.1,
      }, "<+=0.1")
      .from(cards, {
        opacity: 0,
        y: 50,
        stagger: 0.05,
      }, "<+=0.1")
      .from(cta, {
        opacity: 0,
        y: 20,
      }, "<+=0.1");
  });
</script>
