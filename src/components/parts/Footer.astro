---
import Logo from '../../assets/logo.svg';
import { getEnglishLocationName, getEnglishLocationSlug, getLaunchedLocations } from '../../data/locations';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getRouteForLanguage } from '../../i18n/routes';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cityLinks = getLaunchedLocations().map((location) => ({
  href: lang === 'en' ? `/en/${getEnglishLocationSlug(location)}` : `/${location.slug}`,
  label: `${t.footer.cityLinkPrefix} ${lang === 'en' ? getEnglishLocationName(location) : location.city}`,
}));
---

<footer class="bg-primary text-white py-8">
  <div class="container mx-auto px-4">
    <nav class="border-b border-white/20 pb-8" aria-label={t.footer.citiesTitle}>
      <h2 class="text-sm font-semibold uppercase tracking-[0.12em] text-accent">{t.footer.citiesTitle}</h2>
      <ul class="mt-4 grid gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
        {cityLinks.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-white/80 underline-offset-4 hover:text-accent hover:underline transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-8 flex flex-col md:flex-row justify-between items-center">
      <div class="mb-4 md:mb-0 flex flex-col gap-2">
        <p class="text-sm">&copy; {new Date().getFullYear()} Benito González García - {t.footer.copyright}</p>
        <a href={getRouteForLanguage('/politica-de-privacidad', lang)} class="text-sm underline hover:text-accent transition-colors">
          {t.footer.privacyPolicy}
        </a>
      </div>

      <div class="w-[100px] py-4">
        <Logo />
      </div>
    </div>
  </div>
</footer>
