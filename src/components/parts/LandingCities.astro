---
import type { LandingPageData } from '../../data/landingPages';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<section id={t.nav.cities.anchor} class="bg-white py-20">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl">
      <p class="text-[0.98rem] font-semibold uppercase tracking-[0.24em] text-accent md:text-[1.12rem]">{t.landing.cities.eyebrow}</p>
      <h2 class="mt-4 font-segmentA text-[3.2rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[4.4rem]">
        {page.citiesTitle}
      </h2>
      <p class="mt-6 text-lg leading-8 text-gray-700">{page.citiesIntro}</p>
    </div>

    {page.cityLinks.length > 0 && (
      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {page.cityLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-[1.5rem] border border-gray-200 bg-gray-50 p-6 transition hover:-translate-y-1 hover:border-accent"
          >
            <p class="font-segmentA text-[2.2rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[2.5rem]">{link.label}</p>
            <p class="mt-2 text-sm text-gray-600">{link.description}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</section>
