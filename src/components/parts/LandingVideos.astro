---
import type { LandingPageData } from '../../data/landingPages';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));

const getYouTubeEmbedUrl = (rawUrl: string) => {
  try {
    const url = new URL(rawUrl);

    if (url.hostname.includes('youtu.be')) {
      const id = url.pathname.split('/').filter(Boolean)[0];
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
    }

    if (url.hostname.includes('youtube.com')) {
      const id = url.searchParams.get('v') ?? url.pathname.split('/').filter(Boolean).pop();
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
    }
  } catch {
    return null;
  }

  return null;
};

const getInstagramEmbedUrl = (rawUrl: string) => {
  try {
    const url = new URL(rawUrl);
    const cleanedPath = url.pathname.replace(/\/$/, '');
    return `https://www.instagram.com${cleanedPath}/embed/captioned`;
  } catch {
    return null;
  }
};

const getEmbedUrl = (platform: 'youtube' | 'instagram', rawUrl: string) =>
  platform === 'youtube' ? getYouTubeEmbedUrl(rawUrl) : getInstagramEmbedUrl(rawUrl);

const stripSegmentAAccents = (value: string) =>
  value.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
---

<details
  id="videos"
  data-accordion-section
  class="group border-t border-gray-200 bg-white [&_summary::-webkit-details-marker]:hidden"
>
  <summary class="cursor-pointer list-none">
    <div class="container mx-auto flex items-center justify-between gap-6 px-4 py-6 md:py-7">
      <span class="text-[0.98rem] font-semibold uppercase tracking-[0.24em] text-accent md:text-[1.12rem]">
        {t.landing.videos.eyebrow}
      </span>
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-accent/30 text-[1.6rem] leading-none text-primary transition duration-300 group-open:rotate-45">
        +
      </span>
    </div>
  </summary>

  <section class="bg-white pb-20 pt-2">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <h2 class="font-segmentA text-[3.2rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[4.4rem]">
          {stripSegmentAAccents(page.videosTitle)}
        </h2>
        <p class="mt-6 text-lg leading-8 text-gray-700">{page.videosIntro}</p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {page.videos.map((video) => {
          const embedUrl = getEmbedUrl(video.platform, video.url);

          return (
            <article class="overflow-hidden rounded-[1.75rem] border border-gray-200 bg-gray-50 shadow-sm">
              <div class="aspect-[9/16] w-full bg-primary/5 md:aspect-video">
                {embedUrl ? (
                  <iframe
                    src={embedUrl}
                    title={video.title}
                    class="h-full w-full"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                ) : (
                  <div class="flex h-full items-center justify-center p-6 text-center">
                    <a
                      href={video.url}
                      target="_blank"
                      rel="noreferrer"
                      class="text-sm font-semibold uppercase tracking-[0.14em] text-primary underline decoration-accent decoration-2 underline-offset-4"
                    >
                      {t.landing.videos.watchLabel}
                    </a>
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="flex items-center justify-between gap-4">
                  <h3 class="font-segmentA text-[2rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[2.2rem]">
                    {stripSegmentAAccents(video.title)}
                  </h3>
                  <span class="rounded-full bg-primary px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-white">
                    {video.platform}
                  </span>
                </div>
                <p class="mt-3 text-base leading-7 text-gray-700">{video.description}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</details>
