---
import { Image } from "astro:assets";
import { YouTube } from "astro-embed";
import WeddingImage from "../../assets/gallery/sax-wedding.jpg";
import SportsMeetImage from "../../assets/gallery/sports-meet.jpg";
import BolnuevoImage from "../../assets/gallery/bolnuevo.jpg";
import BlamesImage from "../../assets/gallery/blames.jpg";
import FacebookIcon from "../../assets/icons/facebook.svg";
import InstagramIcon from "../../assets/icons/instagram.svg";
import YouTubeIcon from "../../assets/icons/youtube.svg";
import { FadeIn } from '../animations';

import type { Translations } from '../../utils/translations';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;

type GalleryItem = {
  src: ImageMetadata | string;
  alt: string;
  type: "image" | "youtube";
};

const galleryItems: GalleryItem[] = [
  {
    src: WeddingImage,
    alt: translations.gallery.items.weddingImageAlt,
    type: "image",
  },
  {
    src: SportsMeetImage,
    alt: translations.gallery.items.sportsMeetImageAlt,
    type: "image",
  },
  {
    src: BolnuevoImage,
    alt: translations.gallery.items.bolnuevoImageAlt,
    type: "image",
  },
  {
    src: BlamesImage,
    alt: translations.gallery.items.blamesImageAlt,
    type: "image",
  },
  {
    src: "Ent8OtW2DKU",
    alt: translations.gallery.items.flyingFreeAtWeddingYTAlt,
    type: "youtube",
  },
  {
    src: "hILiOtCMEBA",
    alt: translations.gallery.items.destinationCalabriaAtWeddingYTAlt,
    type: "youtube",
  },
  {
    src: "Gq-AV9kIV-4",
    alt: translations.gallery.items.titaniumDavidGuettaYTAlt,
    type: "youtube",
  },
  {
    src: "HsD3AflaXnk",
    alt: translations.gallery.items.versionsAndHouseYTAlt,
    type: "youtube",
  },
];
--- 

<section id={translations.nav.gallery.anchor} class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2
        class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary"
      >
        {translations.gallery.title}
      </h2>
      <p class="text-lg text-black max-w-3xl mx-auto">
        {translations.gallery.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        galleryItems.map((item, idx) => (
          <FadeIn delay={idx * 0.1} duration={0.6}>
            <div class="overflow-hidden rounded-lg shadow-md w-full h-full">
              {item.type === "image" && (
                <Image
                  src={item.src as ImageMetadata}
                  alt={item.alt}
                  class="object-cover w-full h-full transition-transform hover:scale-105"
                />
              )}
              {item.type === "youtube" && (
                <div class="relative h-96">
                  <YouTube id={item.src as string} class="absolute inset-0 w-full h-full" />
                </div>
              )}
            </div>
          </FadeIn>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <p class="text-lg text-black mb-6">
        {translations.gallery.socialText}
      </p>
      <div class="flex justify-center space-x-6">
        <a
          href="https://www.facebook.com/people/Benito-Gonz%C3%A1lez/pfbid02aQaaHf2vJntMAxebPSyQL7Z5KsXh1BGABeSava492qYXhP2frwCm61iDiRY7FfKCl/"
          aria-label={translations.gallery.facebookAriaLabel}
          class="text-primary hover:text-accent transition-colors"
        >
          <FacebookIcon />
        </a>
        <a
          href="https://www.instagram.com/benitogonzalezsax/"
          aria-label={translations.gallery.instagramAriaLabel}
          class="text-primary hover:text-accent transition-colors"
        >
          <InstagramIcon />
        </a>
        <a
          href="https://www.youtube.com/@benitogonzalezsax/featured"
          aria-label={translations.gallery.youtubeAriaLabel}
          class="text-primary hover:text-accent transition-colors"
        >
          <YouTubeIcon />
        </a>
      </div>
    </div>
  </div>
</section>
