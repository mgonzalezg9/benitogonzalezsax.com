---
import PhoneIcon from "../../assets/icons/phone.svg";
import EmailIcon from "../../assets/icons/email.svg";
import LocationIcon from "../../assets/icons/location-pin.svg";
import ClockIcon from "../../assets/icons/clock.svg";
import FacebookIcon from "../../assets/icons/facebook.svg";
import InstagramIcon from "../../assets/icons/instagram.svg";
import YouTubeIcon from "../../assets/icons/youtube.svg";

import type { Translations } from '../../utils/translations';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;
---

<section id={translations.nav.contact.anchor} class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2
        class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary"
      >
        {translations.contact.title}
      </h2>
      <p class="text-lg text-black max-w-3xl mx-auto">
        {translations.contact.description}
      </p>
    </div>

    <div class="bg-gray-50 p-8 rounded-lg h-full">
      <h3 class="text-xl font-semibold mb-6 text-primary">
        {translations.contact.infoTitle}
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex items-start">
          <div class="bg-accent/10 p-3 rounded-full mr-4">
            <PhoneIcon />
          </div>
          <div>
            <h4 class="font-medium text-gray-900">{translations.contact.phone}</h4>
            <p class="text-black">+34 615 97 71 90</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-accent/10 p-3 rounded-full mr-4">
            <EmailIcon />
          </div>
          <div>
            <h4 class="font-medium text-gray-900">{translations.contact.email}</h4>
            <p class="text-black">info@benitogonzalezsax.com</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-accent/10 p-3 rounded-full mr-4">
            <LocationIcon />
          </div>
          <div>
            <h4 class="font-medium text-gray-900">{translations.contact.location}</h4>
            <p class="text-black">{translations.contact.locationDetail}</p>
            <p class="text-black">{translations.contact.locationDetail2}</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-accent/10 p-3 rounded-full mr-4">
            <ClockIcon />
          </div>
          <div>
            <h4 class="font-medium text-gray-900">{translations.contact.schedule}</h4>
            <p class="text-black">{translations.contact.scheduleDetail}</p>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <h4 class="font-medium text-gray-900 mb-4">
          {translations.contact.socialTitle}
        </h4>
        <div class="flex space-x-4">
          <a
            href="https://www.facebook.com/people/Benito-Gonz%C3%A1lez/pfbid02aQaaHf2vJntMAxebPSyQL7Z5KsXh1BGABeSava492qYXhP2frwCm61iDiRY7FfKCl/"
            aria-label={translations.contact.facebookAriaLabel}
            class="text-primary hover:text-accent transition-colors"
          >
            <FacebookIcon />
          </a>
          <a
            href="https://www.instagram.com/benitogonzalezsax/"
            aria-label={translations.contact.instagramAriaLabel}
            class="text-primary hover:text-accent transition-colors"
          >
            <InstagramIcon />
          </a>
          <a
            href="https://www.youtube.com/@benitogonzalezsax/featured"
            aria-label={translations.contact.youtubeAriaLabel}
            class="text-primary hover:text-accent transition-colors"
          >
            <YouTubeIcon />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
