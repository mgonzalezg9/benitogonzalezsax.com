---
import Logo from '../../assets/logo.svg';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import HamburgerMenuIcon from '../../assets/icons/hamburger-menu.svg';
import LanguagePicker from '../ui/LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navSections = [
  { id: t.nav.home.anchor, label: t.nav.home.label, ariaLabel: t.nav.home.ariaDescription },
  { id: t.nav.about.anchor, label: t.nav.about.label, ariaLabel: t.nav.about.ariaDescription },
  { id: t.nav.services.anchor, label: t.nav.services.label, ariaLabel: t.nav.services.ariaDescription },
  { id: t.nav.gallery.anchor, label: t.nav.gallery.label, ariaLabel: t.nav.gallery.ariaDescription },
  { id: t.nav.testimonials.anchor, label: t.nav.testimonials.label, ariaLabel: t.nav.testimonials.ariaDescription },
  { id: t.nav.contact.anchor, label: t.nav.contact.label, ariaLabel: t.nav.contact.ariaDescription },
];
---

<header class="fixed w-full bg-primary backdrop-blur-sm shadow-sm z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center py-0">
      
      <a href="#" class="py-4 w-[100px]" aria-label={t.nav.home.label}>
        <Logo />
      </a>
      
      <nav class="hidden md:flex items-end gap-10">
        <ul class="flex space-x-8">
          {navSections.map(section => (
            <li>
              <a href={`#${section.id}`} class="font-segmentA tracking-wide text-4xl uppercase text-white hover:text-accent transition-colors" aria-label={section.ariaLabel}>
                {section.label}
              </a>
            </li>
          ))}
        </ul>

        <LanguagePicker currentLang={lang} />
      </nav>
      
      <button id="mobile-menu-button" class="md:hidden text-white" aria-label="Toggle mobile menu">
        <HamburgerMenuIcon />
      </button>
    </div>
  </div>
  
  <div id="mobile-menu" class="hidden md:hidden bg-primary w-full">
    <div class="container mx-auto px-4 py-4">
      <ul class="space-y-4">
        {navSections.map(section => (
          <li>
            <a href={`#${section.id}`} class="font-segmentA tracking-wide text-2xl uppercase block text-white hover:text-accent transition-colors" aria-label={section.ariaLabel}>
              {section.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-4">
        <LanguagePicker currentLang={lang} />
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
    
    // Close mobile menu when clicking on a link
    const mobileLinks = mobileMenu?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
      });
    });
  });
</script>