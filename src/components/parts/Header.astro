---
import Logo from '../../assets/logo.svg';
import type { Translations } from '../../utils/translations';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;

const navSections = [
  { id: translations.nav.home.anchor, label: translations.nav.home.label, ariaLabel: translations.nav.home.ariaDescription },
  { id: translations.nav.about.anchor, label: translations.nav.about.label, ariaLabel: translations.nav.about.ariaDescription },
  { id: translations.nav.services.anchor, label: translations.nav.services.label, ariaLabel: translations.nav.services.ariaDescription },
  { id: translations.nav.gallery.anchor, label: translations.nav.gallery.label, ariaLabel: translations.nav.gallery.ariaDescription },
  { id: translations.nav.testimonials.anchor, label: translations.nav.testimonials.label, ariaLabel: translations.nav.testimonials.ariaDescription },
  { id: translations.nav.contact.anchor, label: translations.nav.contact.label, ariaLabel: translations.nav.contact.ariaDescription },
];
---

<header class="fixed w-full bg-primary backdrop-blur-sm shadow-sm z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center py-0">
      
      <a href="#" class="py-4 w-[100px]" aria-label={translations.nav.home.label}>
        <Logo />
      </a>
      
      <nav class="hidden md:block">
        <ul class="flex space-x-8">
          {navSections.map(section => (
            <li>
              <a href={`#${section.id}`} class="font-segmentA tracking-wide text-4xl uppercase text-white hover:text-accent transition-colors" aria-label={section.ariaLabel}>
                {section.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      
      <button id="mobile-menu-button" class="md:hidden text-white" aria-label="Toggle mobile menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  
  <div id="mobile-menu" class="hidden md:hidden bg-primary w-full">
    <ul class="container mx-auto px-4 py-4 space-y-4">
      {navSections.map(section => (
        <li>
          <a href={`#${section.id}`} class="font-segmentA tracking-wide text-2xl uppercase block text-white hover:text-accent transition-colors" aria-label={section.ariaLabel}>
            {section.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
    
    // Close mobile menu when clicking on a link
    const mobileLinks = mobileMenu?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
      });
    });
  });
</script>