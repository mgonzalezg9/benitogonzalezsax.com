---
import Logo from '../../assets/logo.svg';
import { getRouteForLanguage } from '../../i18n/routes';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import LanguagePicker from '../ui/LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const isLandingPage =
  pathname !== '/politica-de-privacidad' && pathname !== '/en/privacy-policy';
const navBase = isLandingPage ? pathname : getRouteForLanguage('/', lang);

const navSections = [
  { id: t.nav.home.anchor, label: t.nav.home.label, ariaLabel: t.nav.home.ariaDescription },
  { id: 'videos', label: 'Videos', ariaLabel: t.landing.floatingCta.videosLabel },
  { id: t.nav.services.anchor, label: t.nav.services.label, ariaLabel: t.nav.services.ariaDescription },
  { id: t.nav.testimonials.anchor, label: t.nav.testimonials.label, ariaLabel: t.nav.testimonials.ariaDescription },
  { id: t.nav.contact.anchor, label: t.nav.contact.label, ariaLabel: t.nav.contact.ariaDescription },
];

const budgetCtaLabel = lang === 'en' ? 'Request quote' : 'Pide presupuesto';
const budgetCtaAriaLabel =
  lang === 'en'
    ? 'Go to the contact section to request a quote'
    : 'Ir a la sección de contacto para pedir presupuesto';
---

<header class="fixed w-full bg-primary backdrop-blur-sm shadow-sm z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center gap-3 py-0">
      
      <a href={getRouteForLanguage('/', lang)} class="py-4 w-[100px]" aria-label={t.nav.home.label}>
        <Logo />
      </a>

      <a
        href={`${navBase}#contacto`}
        class="md:hidden inline-flex shrink-0 items-center justify-center rounded-[0.35rem] border-2 border-white px-3 py-1.5 text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-white transition-colors hover:border-accent hover:text-accent"
        aria-label={budgetCtaAriaLabel}
      >
        {budgetCtaLabel}
      </a>
      
      <nav class="hidden md:flex items-end gap-10">
        <ul class="flex space-x-8">
          {navSections.map((section, index) => (
            <>
              <li>
                <a href={`${navBase}#${section.id}`} class="font-segmentA tracking-wide text-4xl uppercase text-white hover:text-accent transition-colors" aria-label={section.ariaLabel}>
                  {section.label}
                </a>
              </li>
              {index === 0 && (
                <li>
                  <a
                    href={`${navBase}#contacto`}
                    class="mt-1 inline-flex items-center rounded-[0.35rem] border-2 border-white px-5 py-1.5 text-[1rem] font-semibold uppercase tracking-[0.08em] text-white transition-colors hover:border-accent hover:text-accent"
                    aria-label={budgetCtaAriaLabel}
                  >
                    {budgetCtaLabel}
                  </a>
                </li>
              )}
            </>
          ))}
        </ul>

        <LanguagePicker />
      </nav>
      
      <button id="mobile-menu-button" class="md:hidden shrink-0 text-white" aria-label="Toggle mobile menu">
        <!-- Hamburger menu icon. Creating a component does not work idk why -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  
  <div id="mobile-menu" class="hidden md:hidden bg-primary w-full">
    <div class="container mx-auto px-4 py-4">
      <ul class="space-y-4">
        {navSections.map(section => (
          <>
            <li>
              <a href={`${navBase}#${section.id}`} class="font-segmentA tracking-wide text-2xl uppercase block text-white hover:text-accent transition-colors" aria-label={section.ariaLabel}>
                {section.label}
              </a>
            </li>
          </>
        ))}
      </ul>

      <div class="mt-4">
        <LanguagePicker />
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
    
    // Close mobile menu when clicking on a link
    const mobileLinks = mobileMenu?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
      });
    });
  });
</script>
