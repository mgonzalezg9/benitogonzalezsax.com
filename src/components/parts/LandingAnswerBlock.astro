---
import type { LandingPageData } from '../../data/landingPages';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { stripSegmentAAccents } from '../../lib/typography';
import LandingAccordionSection from './LandingAccordionSection.astro';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<LandingAccordionSection eyebrow={t.landing.answerBlock.eyebrow}>
  <section class="bg-white pb-20 pt-2">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <h2 class="font-segmentA text-[3rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[4.2rem]">
          {stripSegmentAAccents(page.answerBlockTitle)}
        </h2>
        <p class="mt-6 text-lg leading-8 text-gray-700">
          {page.answerBlockIntro}
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {page.answerCards.map((card) => (
          <article class="rounded-[1.75rem] border border-gray-200 bg-gray-50 p-6 shadow-sm">
            <h3 class="font-segmentA text-[2.1rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[2.4rem]">
              {stripSegmentAAccents(card.title)}
            </h3>
            <p class="mt-4 text-base leading-7 text-gray-700">{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</LandingAccordionSection>
