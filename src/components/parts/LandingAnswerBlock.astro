---
import type { LandingPageData } from '../../data/landingPages';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));

const stripSegmentAAccents = (value: string) =>
  value.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
---

<details
  data-accordion-section
  class="group border-t border-gray-200 bg-white [&_summary::-webkit-details-marker]:hidden"
>
  <summary class="cursor-pointer list-none">
    <div class="container mx-auto flex items-center justify-between gap-6 px-4 py-6 md:py-7">
      <span class="text-[0.98rem] font-semibold uppercase tracking-[0.24em] text-accent md:text-[1.12rem]">
        {t.landing.answerBlock.eyebrow}
      </span>
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-accent/30 text-[1.6rem] leading-none text-primary transition duration-300 group-open:rotate-45">
        +
      </span>
    </div>
  </summary>

  <section class="bg-white pb-20 pt-2">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl">
        <h2 class="font-segmentA text-[3rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[4.2rem]">
          {stripSegmentAAccents(page.answerBlockTitle)}
        </h2>
        <p class="mt-6 text-lg leading-8 text-gray-700">
          {page.answerBlockIntro}
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {page.answerCards.map((card) => (
          <article class="rounded-[1.75rem] border border-gray-200 bg-gray-50 p-6 shadow-sm">
            <h3 class="font-segmentA text-[2.1rem] font-bold uppercase tracking-[0.08em] text-primary md:text-[2.4rem]">
              {stripSegmentAAccents(card.title)}
            </h3>
            <p class="mt-4 text-base leading-7 text-gray-700">{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</details>
