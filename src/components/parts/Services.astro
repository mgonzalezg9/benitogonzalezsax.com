---
import RingIcon from "../../assets/icons/ring.svg";
import BriefcaseIcon from "../../assets/icons/briefcase.svg";
import PartyIcon from "../../assets/icons/party.svg";
import HotelIcon from "../../assets/icons/hotel.svg";
import { FadeIn } from '../animations';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = t.services.items.map((item, index) => ({
  ...item,
  icon: ["ring", "briefcase", "party", "hotel"][index],
}));
---

<section id={t.nav.services.anchor} class="py-20 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2
        class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary"
      >
        {t.services.title}
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        {t.services.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        services.map((service, idx) => (
          <FadeIn delay={idx * 0.2} duration={0.6}>
            <div class="service-card bg-white rounded-lg shadow-md p-6 transition-transform hover:-translate-y-2">
              <div class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center mb-6 mx-auto">
                {service.icon === "ring" && <RingIcon />}
                {service.icon === "briefcase" && <BriefcaseIcon />}
                {service.icon === "party" && <PartyIcon />}
                {service.icon === "hotel" && <HotelIcon />}
              </div>

              <h3 class="text-xl uppercase font-semibold mb-3 text-center text-black">
                {service.title}
              </h3>
              <p class="text-gray-600 text-center">{service.description}</p>
            </div>
          </FadeIn>
        ))
      }
    </div>

    <div class="mt-16 text-center">
      <a
        href={`#${t.nav.contact.anchor}`}
        aria-label={t.services.ctaAriaLabel}
        class="font-segmentA uppercase text-4xl tracking-wide inline-block bg-accent hover:bg-amber-400 text-white font-medium pb-2 px-8 rounded-full transition-colors"
      >
        {t.services.ctaButton}
      </a>
    </div>
  </div>
</section>
