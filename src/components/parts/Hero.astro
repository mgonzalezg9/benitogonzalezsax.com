---
import HeroImage from '../../assets/hero-image.jpg'
import { Image } from 'astro:assets';
import { FadeIn } from '../animations';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id={t.nav.home.anchor} class="relative h-screen flex items-center justify-center bg-gray-900 text-white overflow-hidden">
  <div class="absolute inset-0 z-0">
    <Image
      src={HeroImage}
      alt={t.hero.subtitle} 
      class="w-full h-full object-cover opacity-50"
      loading="eager"
      width={1385}
      height={1385}
    />
  </div>
  
  <div class="container mx-auto px-4 z-10 text-center">
    <FadeIn duration={1.2}>
      <h1 class="text-7xl md:text-9xl font-bold font-segmentA uppercase mb-4">{t.hero.title}</h1>
      <h2 class="text-xl md:text-2xl mb-8 lg:w-1/2 lg:mx-auto">{t.hero.subtitle}</h2>
    </FadeIn>

    <FadeIn duration={1.2} delay={0.6}>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href={`#${t.nav.contact.anchor}`} aria-label={t.hero.contactAriaLabel} class="font-segmentA uppercase text-4xl tracking-wide bg-accent hover:bg-amber-400 text-white font-medium pb-2 px-8 rounded-full transition-colors">
          {t.hero.contactButton}
        </a>
        <a href={`#${t.nav.gallery.anchor}`} aria-label={t.hero.galleryAriaLabel} class="font-segmentA uppercase text-4xl tracking-wide bg-transparent hover:bg-white/10 border border-white text-white font-medium pb-2 px-8 rounded-full transition-colors">
          {t.hero.galleryButton}
        </a>
      </div>
    </FadeIn>
  </div>
  
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <FadeIn duration={1.2} delay={1.5}>
      <a href={`#${t.nav.about.anchor}`} aria-label={t.hero.aboutAriaLabel} class="text-white">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </FadeIn>
  </div>
</section>
