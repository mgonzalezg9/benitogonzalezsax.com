---
import { Image } from 'astro:assets'
import AboutImage from '../../assets/about-image.jpg'
import { FadeIn, Counter } from '../animations';
import type { Translations } from '../../utils/translations';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;
---

<section id={translations.nav.about.anchor} class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <div class="md:w-1/2">
        <FadeIn direction="horizontal" distance={-20} duration={1.2}>
          <Image
            src={AboutImage}
            alt={translations.about.imageAlt} 
            class="rounded-lg shadow-lg w-full h-auto"
          />
        </FadeIn>
      </div>
      
      <div class="md:w-1/2 text-justify">
        <h2 class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary">{translations.about.title}</h2>
        <p class="text-lg mb-4 text-gray-700">
          {translations.about.paragraph1}
        </p>
        <p class="text-lg mb-4 text-gray-700">
          {translations.about.paragraph2}
        </p>
        <p class="text-lg mb-6 text-gray-700">
          {translations.about.paragraph3}
        </p>
        
        <div class="flex flex-wrap gap-4">
          <div class="bg-gray-100 rounded-lg p-4 flex-1 min-w-[150px]">
            <div class="flex text-accent text-3xl font-bold text-left">
              +<Counter target={120} />
            </div>
            <div class="text-gray-600">{translations.about.stats.events}</div>
          </div>
          <div class="bg-gray-100 rounded-lg p-4 flex-1 min-w-[150px]">
            <div class="flex text-accent text-3xl font-bold text-left">
              +<Counter target={10} />
            </div>
            <div class="text-gray-600">{translations.about.stats.experienceYears}</div>
          </div>
          <div class="bg-gray-100 rounded-lg p-4 flex-1 min-w-[150px]">
            <div class="flex text-accent text-3xl font-bold text-left">
              <Counter target={100} />%
            </div>
            <div class="text-gray-600">{translations.about.stats.satisfiedClients}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>