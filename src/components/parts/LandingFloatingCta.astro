---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const contactAnchor = t.nav.contact.anchor;
const videosAnchor = t.landing.videos.anchor;
---

<div class="md:contents">
  <a
    href={`#${contactAnchor}`}
    data-floating-cta
    class="pointer-events-none fixed bottom-20 right-4 z-40 inline-flex min-h-11 translate-y-4 items-center justify-center rounded-[999px] bg-accent px-6 py-2.5 text-[0.67rem] font-semibold uppercase tracking-[0.06em] text-white opacity-0 shadow-lg shadow-black/15 transition duration-300 hover:bg-amber-400 md:bottom-6 md:left-[calc(50%-7rem)] md:right-auto md:min-h-11 md:-translate-x-1/2 md:px-5 md:py-3 md:text-[0.82rem] md:tracking-[0.08em]"
  >
    {t.landing.floatingCta.budgetLabel}
  </a>

  <a
    href={`#${videosAnchor}`}
    data-floating-videos-cta
    class="pointer-events-none fixed bottom-20 left-4 z-30 inline-flex min-h-10 translate-y-4 items-center justify-center rounded-[999px] border border-accent bg-white px-5 py-2.5 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-accent opacity-0 shadow-lg shadow-black/10 transition duration-300 hover:bg-amber-50 md:bottom-6 md:left-[calc(50%+7rem)] md:min-h-11 md:-translate-x-1/2 md:px-5 md:py-3 md:text-[0.82rem]"
  >
    {t.landing.floatingCta.videosLabel}
  </a>
</div>

<script define:vars={{ contactAnchor, videosAnchor }}>
  document.addEventListener('DOMContentLoaded', () => {
    const primaryHeroCta = document.querySelector('[data-primary-hero-cta]');
    const floatingCta = document.querySelector('[data-floating-cta]');
    const floatingVideosCta = document.querySelector('[data-floating-videos-cta]');

    if (primaryHeroCta instanceof HTMLElement && floatingCta instanceof HTMLElement) {
      const syncFloatingCta = () => {
        const heroButtonVisible = (() => {
          const rect = primaryHeroCta.getBoundingClientRect();
          return rect.bottom > 0 && rect.top < window.innerHeight;
        })();

        const contactSection = document.getElementById(contactAnchor);
        const videosSection = document.getElementById(videosAnchor);
        const nearContact = contactSection
          ? contactSection.getBoundingClientRect().top < window.innerHeight * 0.75
          : false;
        const nearVideos = videosSection
          ? videosSection.getBoundingClientRect().top < window.innerHeight * 0.75
          : false;

        const shouldShow = !heroButtonVisible && !nearContact;
        const shouldShowVideos = !heroButtonVisible && !nearVideos && !nearContact;

        floatingCta.classList.toggle('pointer-events-none', !shouldShow);
        floatingCta.classList.toggle('opacity-0', !shouldShow);
        floatingCta.classList.toggle('translate-y-4', !shouldShow);
        floatingCta.classList.toggle('opacity-100', shouldShow);
        floatingCta.classList.toggle('translate-y-0', shouldShow);

        if (floatingVideosCta instanceof HTMLElement) {
          floatingVideosCta.classList.toggle('pointer-events-none', !shouldShowVideos);
          floatingVideosCta.classList.toggle('opacity-0', !shouldShowVideos);
          floatingVideosCta.classList.toggle('translate-y-4', !shouldShowVideos);
          floatingVideosCta.classList.toggle('opacity-100', shouldShowVideos);
          floatingVideosCta.classList.toggle('translate-y-0', shouldShowVideos);
        }
      };

      syncFloatingCta();
      window.addEventListener('scroll', syncFloatingCta, { passive: true });
      window.addEventListener('resize', syncFloatingCta);
    }
  });
</script>
