---
import { FadeIn } from '../animations';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const testimonials = t.testimonials.items;
---

<section id={t.nav.testimonials.anchor} class="py-20 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary">{t.testimonials.title}</h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        {t.testimonials.description}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 md:gap-x-10 gap-y-4">
      {testimonials.map((testimonial, idx) => (
        <FadeIn delay={idx * 0.2} duration={0.6}>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="flex items-center mb-4">
              {/* Avatar */}
              {/* <img 
                src={testimonial.image} 
                alt={testimonial.name} 
                class="w-16 h-16 rounded-full mr-4"
              /> */}
              <div>
                <h3 class="font-semibold text-lg text-primary uppercase">{testimonial.name}</h3>
                <p class="text-gray-500">{testimonial.role}</p>
              </div>
            </div>
            <p class="text-gray-600 italic">"{testimonial.quote}"</p>
          </div>
        </FadeIn>
      ))}
    </div>
  </div>
</section>