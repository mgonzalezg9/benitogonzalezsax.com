---
import { Image } from 'astro:assets'
import AboutImage from '../assets/about-image.jpg'
import FadeIn from './animations/FadeIn.astro';
---

<section id="sobre-mi" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <div class="md:w-1/2">
        <FadeIn direction="horizontal" distance={-20} duration={1.2}>
          <Image
            src={AboutImage}
            alt="Benito González García - Saxofonista" 
            class="rounded-lg shadow-lg w-full h-auto"
          />
        </FadeIn>
      </div>
      
      <div class="md:w-1/2 text-justify">
        <h2 class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary">Sobre mi</h2>
        <p class="text-lg mb-4 text-gray-700">
          Soy Benito González García, saxofonista profesional con más de 10 años de experiencia, especializado en eventos exclusivos. Desde mis inicios, mi pasión por el saxofón me ha llevado a perfeccionar mi técnica y estilo, destacando en bodas, eventos corporativos, discotecas y presentaciones de marca.
        </p>
        <p class="text-lg mb-4 text-gray-700">
          He tenido el honor de actuar en numerosos eventos, desde bodas íntimas hasta grandes celebraciones corporativas, aportando un toque de elegancia y emoción con mi música en vivo. Trabajo con marcas reconocidas como Martin Miller's Gin e IQOS, ofreciendo un servicio musical de alto nivel.
        </p>
        <p class="text-lg mb-6 text-gray-700">
          Mi especialidad es el saxofón en cócteles y barra libre para bodas, saxo y DJ en discotecas y eventos corporativos exclusivos. Mi repertorio incluye géneros como jazz, house, afrohouse, EDM, electrónica y reggaetón, adaptándome a cada ambiente para crear experiencias musicales inolvidables.
        </p>
        
        <div class="flex flex-wrap gap-4">
          <div class="bg-gray-100 rounded-lg p-4 flex-1 min-w-[150px]">
            <div class="text-accent text-3xl font-bold counter" data-target="120">+0</div>
            <div class="text-gray-600">Eventos</div>
          </div>
          <div class="bg-gray-100 rounded-lg p-4 flex-1 min-w-[150px]">
            <div class="text-accent text-3xl font-bold counter" data-target="10">+0</div>
            <div class="text-gray-600">Años de experiencia</div>
          </div>
          <div class="bg-gray-100 rounded-lg p-4 flex-1 min-w-[150px]">
            <div class="text-accent text-3xl font-bold counter" data-target="100" data-suffix="%">0%</div>
            <div class="text-gray-600">Clientes satisfechos</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const counters = document.querySelectorAll('.counter');
    let countersAnimated = false;

    function animateCounter(counter: HTMLElement) {
      const targetAttr = counter.getAttribute('data-target');
      if (!targetAttr) return;
      const target = +targetAttr;
      const suffix = counter.getAttribute('data-suffix') || '';
      const text = counter.textContent || '';
      const isPlus = text.trim().startsWith('+');
      let start = 0;
      const duration = 1200;
      const stepTime = Math.max(Math.floor(duration / target), 20);
      function update() {
        start++;
        if (start <= target) {
          counter.textContent = (isPlus ? '+' : '') + start + suffix;
          setTimeout(update, stepTime);
        } else {
          counter.textContent = (isPlus ? '+' : '') + target + suffix;
        }
      }
      update();
    }

    const observer = new window.IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (!countersAnimated && entry.target.closest('section')) {
              counters.forEach(counter => animateCounter(counter as HTMLElement));
              countersAnimated = true;
            }
          }
        });
      },
      { threshold: 0.2 }
    );
    
    // Observe the first counter's parent (the section)
    if (counters.length) {
      const section = counters[0].closest('section');
      if (section) observer.observe(section);
    }
  }
</script>