---
import PhoneIcon from "../assets/icons/phone.svg";
import EmailIcon from "../assets/icons/email.svg";
import LocationIcon from "../assets/icons/location-pin.svg";
import ClockIcon from "../assets/icons/clock.svg";
import FacebookIcon from "../assets/icons/facebook.svg";
import InstagramIcon from "../assets/icons/instagram.svg";
import YouTubeIcon from "../assets/icons/youtube.svg";
---

<section id="contacto" class="py-12 md:py-16 lg:py-20 bg-white min-h-screen flex items-center">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2
        class="font-segmentA uppercase tracking-wide text-6xl md:text-8xl font-bold mb-6 text-primary"
      >
        Contacto
      </h2>
      <p class="text-lg text-black max-w-3xl mx-auto">
        ¿Interesado en mis servicios? Ponte en contacto conmigo para más
        información o para solicitar un presupuesto personalizado.
      </p>
    </div>

    <div class="bg-gray-50 p-8 rounded-lg h-full">
      <h3 class="text-xl font-semibold mb-6 text-primary">
        Información de contacto
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex items-start">
          <div class="bg-accent/10 p-3 rounded-full mr-4">
            <PhoneIcon />
          </div>
          <div>
            <h4 class="font-medium text-gray-900">Teléfono</h4>
            <p class="text-black">+34 615 97 71 90</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-accent/10 p-3 rounded-full mr-4">
            <EmailIcon />
          </div>
          <div>
            <h4 class="font-medium text-gray-900">Email</h4>
            <p class="text-black">info@benitogonzalezsax.com</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-accent/10 p-3 rounded-full mr-4">
            <LocationIcon />
          </div>
          <div>
            <h4 class="font-medium text-gray-900">Ubicación</h4>
            <p class="text-black">Murcia, España</p>
            <p class="text-black">Disponible para eventos en toda España</p>
          </div>
        </div>

        <div class="flex items-start">
          <div class="bg-accent/10 p-3 rounded-full mr-4">
            <ClockIcon />
          </div>
          <div>
            <h4 class="font-medium text-gray-900">Horario</h4>
            <p class="text-black">Lunes a Domingo: 9:00 - 22:00</p>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <h4 class="font-medium text-gray-900 mb-4">
          Sígueme en redes sociales
        </h4>
        <div class="flex space-x-4">
          <a
            href="https://www.facebook.com/people/Benito-Gonz%C3%A1lez/pfbid02aQaaHf2vJntMAxebPSyQL7Z5KsXh1BGABeSava492qYXhP2frwCm61iDiRY7FfKCl/"
            aria-label="Facebook de Benito González"
            class="text-primary hover:text-accent transition-colors"
          >
            <FacebookIcon />
          </a>
          <a
            href="https://www.instagram.com/benitogonzalezsax/"
            aria-label="Instagram de Benito González"
            class="text-primary hover:text-accent transition-colors"
          >
            <InstagramIcon />
          </a>
          <a
            href="https://www.youtube.com/@benitogonzalezsax/featured"
            aria-label="YouTube de Benito González"
            class="text-primary hover:text-accent transition-colors"
          >
            <YouTubeIcon />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector("#contacto");

    if (!section) {
      console.error(`Section not found`);
      return;
    }

    const title = section.querySelector("h2");
    const description = section.querySelector(".text-lg");
    const subtitle = section.querySelector("h3");
    const contactInfo = section.querySelectorAll(".flex.items-start");
    const socialSection = section.querySelector(".mt-8");

    const splitTitle = new SplitText(title, { type: "lines" });
    const splitDesc = new SplitText(description, { type: "lines" });
    const splitSubtitle = new SplitText(subtitle, { type: "lines" });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom top",
        scrub: 1,
        pin: true,
        anticipatePin: 1
      },
      defaults: { ease: "none" }
    });

    tl.from(splitTitle.lines, {
      opacity: 0,
      y: 50,
      stagger: 0.02,
    })
    .from(splitDesc.lines, {
      opacity: 0,
      y: 20,
      stagger: 0.1,
    }, "<+=0.1")
    .from(splitSubtitle.lines, {
      opacity: 0,
      y: 20,
      stagger: 0.02,
    }, "<+=0.1")
    .from(contactInfo, {
      opacity: 0,
      x: -50,
      stagger: 0.1,
      duration: 0.5,
      ease: "power4.out",
    }, "<+=0.1")
    .from(socialSection, {
      opacity: 0,
      y: 30,
      duration: 0.5,
    }, "<+=0.1");
  });
</script>
