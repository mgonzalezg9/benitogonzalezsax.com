---
import { Image } from 'astro:assets';
import { translations } from '../../i18n/ui';
import { getLangFromUrl } from '../../i18n/utils';
import { getRouteForLanguage } from '../../i18n/routes';
import type { Language } from '../../i18n/ui';

import SpainFlag from '../../assets/icons/es.svg';
import UnitedKingdomFlag from '../../assets/icons/en.svg';

type Flag = {
  icon: ImageMetadata;
  label: string;
};

type LanguageOption = {
  lang: string;
  href: string;
  icon: ImageMetadata;
  label: string;
};

const currentLang = getLangFromUrl(Astro.url);
const currentPathname = Astro.url.pathname;

const flags: Record<string, Flag> = {
  en: {
    icon: UnitedKingdomFlag,
    label: 'En'
  },
  es: {
    icon: SpainFlag,
    label: 'Es'
  }
};

const languageOptions: LanguageOption[] = Object.entries(translations).map(([lang]) => {
  const href = getRouteForLanguage(currentPathname, lang as Language);
  return {
    lang,
    href,
    ...flags[lang]
  };
});
---

<div class="flex items-center gap-3">
  {languageOptions.map(({ lang, href, icon, label }) => (
    currentLang === lang ? (
      <span class="flex items-center gap-1 tracking-wide sm:text-xl uppercase text-white opacity-100" aria-current="true">
        <Image src={icon} alt={`${label} flag`} width="24" height="24" />
        {label}
      </span>
    ) : (
      <a
        href={href}
        class="flex items-center gap-1 tracking-wide sm:text-xl uppercase text-white/60 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-white/50 rounded"
      >
        <Image src={icon} alt={`${label} flag`} width="24" height="24" />
        {label}
      </a>
    )
  ))}
</div>
