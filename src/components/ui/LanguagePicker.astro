---
import { Image } from 'astro:assets';
import { translations } from '../../i18n/ui';
import { getLangFromUrl } from '../../i18n/utils';
import { getRouteForLanguage } from '../../i18n/routes';
import type { Language } from '../../i18n/ui';

import SpainFlag from '../../assets/icons/es.svg';
import UnitedKingdomFlag from '../../assets/icons/en.svg';

type Flag = {
  icon: ImageMetadata;
  label: string;
};

type LanguageOption = {
  lang: string;
  href: string;
  icon: ImageMetadata;
  label: string;
};

const currentLang = getLangFromUrl(Astro.url);
const currentPathname = Astro.url.pathname;

const flags: Record<string, Flag> = {
  en: {
    icon: UnitedKingdomFlag,
    label: 'En'
  },
  es: {
    icon: SpainFlag,
    label: 'Es'
  }
};

const languageOptions: LanguageOption[] = Object.entries(translations).map(([lang]) => {
  const href = getRouteForLanguage(currentPathname, lang as Language);
  return {
    lang,
    href,
    ...flags[lang]
  };
});
---

<div class="relative inline-block text-left">
  <select
    class="language-picker block w-full px-8 sm:px-10 py-1 text-white bg-transparent tracking-wide sm:text-xl uppercase appearance-none focus:outline-none focus:ring-2 focus:ring-white/50 rounded"
  >
    {languageOptions.map(({ lang, href, label }) => (
      <option value={href} selected={currentLang === lang}>
        {label}
      </option>
    ))}
  </select>
  <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-0 sm:pl-2">
     <Image 
        src={flags[currentLang].icon} 
        alt={`${flags[currentLang].label} flag`}
        width="24"
        height="24"
      />
  </div>
  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2">
    <!-- Chevron icon. Creating a component does not work idk why -->
    <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
  </svg>
  </div>
</div>

<style>
  select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }
</style>

<script>
import { defaultLang } from "../../i18n/ui";

  document.addEventListener('DOMContentLoaded', () => {
    const languagePickers = document.querySelectorAll('.language-picker');

    languagePickers.forEach(selector => {
      selector.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        if (target.value) {
          // Use the href value directly as it's already computed with route mapping
          const newPath = target.value === `/${defaultLang}/` ? '/' : target.value;
          window.location.href = window.location.origin + newPath;
        }
      });
    });
  });
</script>
