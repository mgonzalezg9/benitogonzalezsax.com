const answerCardsDisplay =
  page.type === 'home'
    ? [
        {
          title: 'Qué servicio ofrezco',
          body:
            'Saxo en directo para bodas y eventos, con actuaciones pensadas para ceremonia, cóctel, banquete, barra libre y sesiones con DJ.',
        },
        {
          title: 'Dónde puedo actuar',
          body:
            'Trabajo en bodas tanto de la Península como de Baleares, adaptando la actuación al lugar, la fecha y el estilo de cada celebración.',
        },
        {
          title: 'Cómo se adapta a vuestra boda',
          body:
            'Puedo actuar solo, coordinarme con wedding planners y espacios o integrarme en un formato Saxo + DJ para darle más energía a la fiesta.',
        },
        {
          title: 'Cómo pedir presupuesto',
          body:
            'Solo necesitas enviar fecha, ciudad, lugar y momentos de actuación por formulario o WhatsApp para recibir una propuesta.',
        },
