---
import { Image } from 'astro:assets';
import AboutImage from '../../assets/about-image.jpg';
import JessicaValdesAvatar from '../../assets/testimonials/jessica-valdes.png';
import NicolasRodriguezCarmonaAvatar from '../../assets/testimonials/nicolas-rodriguez-carmona.png';
import RafaelValeroAgulloAvatar from '../../assets/testimonials/rafael-valero-agullo.png';
import VincentSextonAvatar from '../../assets/testimonials/vincent-sexton.png';
import EvaPelegrinAvatar from '../../assets/testimonials/eva-pelegrin.png';
import KarenAvatar from '../../assets/testimonials/karen.jpg';
import BettyAvatar from '../../assets/testimonials/betty.jpg';
import JackAvatar from '../../assets/testimonials/jack.jpg';
import YolandaAvatar from '../../assets/testimonials/yolanda.jpg';
import type { LandingPageData } from '../../data/landingPages';
import { BUSINESS } from '../../lib/site';

interface Props {
  page: LandingPageData;
}

const { page } = Astro.props;

const getYouTubeEmbedUrl = (rawUrl: string) => {
  try {
    const url = new URL(rawUrl);

    if (url.hostname.includes('youtu.be')) {
      const id = url.pathname.split('/').filter(Boolean)[0];
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
    }

    if (url.hostname.includes('youtube.com')) {
      const id = url.searchParams.get('v') ?? url.pathname.split('/').filter(Boolean).pop();
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
    }
  } catch {
    return null;
  }

  return null;
};

const getInstagramEmbedUrl = (rawUrl: string) => {
  try {
    const url = new URL(rawUrl);
    const cleanedPath = url.pathname.replace(/\/$/, '');
    return `https://www.instagram.com${cleanedPath}/embed/captioned`;
  } catch {
    return null;
  }
};

const getEmbedUrl = (platform: 'youtube' | 'instagram', rawUrl: string) =>
  platform === 'youtube' ? getYouTubeEmbedUrl(rawUrl) : getInstagramEmbedUrl(rawUrl);

const stripSegmentAAccents = (value: string) =>
  value.normalize('NFD').replace(/[\u0300-\u036f]/g, '');

const introDemoVideo = {
  title: 'Vídeo demostración para Bodas',
  platform: 'youtube' as const,
  url: 'https://www.youtube.com/shorts/-it5RoaROgU',
};
const introDemoEmbedUrl = introDemoVideo ? getEmbedUrl(introDemoVideo.platform, introDemoVideo.url) : null;

const testimonialAvatars = {
  'jessica-valdes': JessicaValdesAvatar,
  'nicolas-rodriguez-carmona': NicolasRodriguezCarmonaAvatar,
  'rafael-valero-agullo': RafaelValeroAgulloAvatar,
  'vincent-sexton': VincentSextonAvatar,
  'eva-pelegrin': EvaPelegrinAvatar,
  karen: KarenAvatar,
  betty: BettyAvatar,
  jack: JackAvatar,
  yolanda: YolandaAvatar,
} as const;

const answerBlockHeading =
  page.type === 'home'
    ? 'Todo lo que necesitas saber antes de contratar'
    : `Por qué elegir un saxofonista para bodas en ${page.heroTitle.replace('Saxofonista para bodas en ', '')}`;

const cityName = page.heroTitle.replace('Saxofonista para bodas en ', '');

const answerBlockIntro =
  page.type === 'home'
    ? 'Un resumen claro sobre el servicio, los formatos disponibles, las zonas en las que trabajo y la forma más rápida de pedir presupuesto.'
