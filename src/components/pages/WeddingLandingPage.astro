<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('lead-form');
    const primaryHeroCta = document.querySelector('[data-primary-hero-cta]');
    const floatingCta = document.querySelector('[data-floating-cta]');
    const floatingVideosCta = document.querySelector('[data-floating-videos-cta]');
    const openAccordionTarget = (hash: string) => {
      if (!hash.startsWith('#')) return;
      const target = document.getElementById(hash.slice(1));
      if (target instanceof HTMLDetailsElement) {
        target.open = true;
      }
    };

    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    if (primaryHeroCta instanceof HTMLElement && floatingCta instanceof HTMLElement) {
      const syncFloatingCta = () => {
        const heroButtonVisible = (() => {
          const rect = primaryHeroCta.getBoundingClientRect();
          return rect.bottom > 0 && rect.top < window.innerHeight;
        })();

        const contactSection = document.getElementById('contacto');
        const videosSection = document.getElementById('videos');
        const nearContact = contactSection
          ? contactSection.getBoundingClientRect().top < window.innerHeight * 0.75
          : false;
        const nearVideos = videosSection
          ? videosSection.getBoundingClientRect().top < window.innerHeight * 0.75
          : false;

        const shouldShow = !heroButtonVisible && !nearContact;
        const shouldShowVideos = !heroButtonVisible && !nearVideos && !nearContact;

        floatingCta.classList.toggle('pointer-events-none', !shouldShow);
        floatingCta.classList.toggle('opacity-0', !shouldShow);
        floatingCta.classList.toggle('translate-y-4', !shouldShow);
        floatingCta.classList.toggle('opacity-100', shouldShow);
        floatingCta.classList.toggle('translate-y-0', shouldShow);

        if (floatingVideosCta instanceof HTMLElement) {
          floatingVideosCta.classList.toggle('pointer-events-none', !shouldShowVideos);
          floatingVideosCta.classList.toggle('opacity-0', !shouldShowVideos);
          floatingVideosCta.classList.toggle('translate-y-4', !shouldShowVideos);
          floatingVideosCta.classList.toggle('opacity-100', shouldShowVideos);
          floatingVideosCta.classList.toggle('translate-y-0', shouldShowVideos);
        }
      };

      syncFloatingCta();
      window.addEventListener('scroll', syncFloatingCta, { passive: true });
      window.addEventListener('resize', syncFloatingCta);
    }

    openAccordionTarget(window.location.hash);
    window.addEventListener('hashchange', () => openAccordionTarget(window.location.hash));

    document.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href');
        if (href) {
          openAccordionTarget(href);
        }
      });
    });

    const buildMessage = () => {
      const data = new FormData(form);
      const fields = [
        ['Nombre', data.get('nombre') || ''],
        ['Email', data.get('email') || ''],
        ['Teléfono', data.get('telefono') || ''],
        ['Fecha', data.get('fecha') || ''],
        ['Ciudad o lugar', data.get('ciudad') || ''],
        ['Servicio', data.get('servicio') || ''],
        ['Mensaje', data.get('mensaje') || ''],
      ];

      return fields
        .filter(([, value]) => String(value).trim().length > 0)
        .map(([label, value]) => `${label}: ${value}`)
        .join('\n');
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) {
        return;
      }

      const subject = form.dataset.mailSubject || 'Solicitud de presupuesto';
      const body = buildMessage();
      window.location.href = `mailto:info@benitogonzalezsax.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });

    const whatsappButton = form.querySelector('[data-action="whatsapp"]');
    whatsappButton?.addEventListener('click', () => {
      if (!form.reportValidity()) {
        return;
      }

      const base = form.dataset.whatsappBase || 'https://wa.me/34615977190';
      const body = buildMessage();
      window.open(`${base}?text=${encodeURIComponent(body)}`, '_blank', 'noopener,noreferrer');
    });
  });
</script>
